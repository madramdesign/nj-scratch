{
  "name": "nj-scratch",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run -w @nj/api dev",
    "dev:web": "npm run -w @nj/web dev",
    "start": "npm run -w @nj/web build && npm run -w @nj/api start",
    "scrape": "tsx packages/scraper/src/cli.ts",
    "backfill": "tsx packages/scraper/src/backfill-cli.ts",
    "health": "tsx packages/scraper/src/health.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
