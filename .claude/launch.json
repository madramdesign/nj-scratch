{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 5173
    },
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--config",
        "apps/web/vite.config.ts",
        "--outDir",
        "apps/web/dist",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "env": {
        "VITE_BASE": "/nj-scratch/"
      }
    }
  ]
}
